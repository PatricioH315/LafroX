{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar Subdocumento 4",
      "type": "shell",
      "command": "latexmk",
      "args": [
        "-cd",
        "-lualatex",
        "-halt-on-error",
        "main.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}/SUBDOCUMENTO_4/Subdocumento_4_LateX"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
