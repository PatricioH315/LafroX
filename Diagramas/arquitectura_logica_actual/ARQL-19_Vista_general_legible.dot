digraph VistaGeneral {
  graph [rankdir=TB, bgcolor="white", pad="0.20", nodesep="0.22", ranksep="0.18", splines=polyline, label="ARQUITECTURA LÓGICA · LARAVEL", labelloc=t, fontname="Arial", fontsize=20, fontcolor="#17304D"];
  node [shape=box, style="rounded,filled", color="#1E4C70", fillcolor="#EEF5F8", fontname="Arial", fontsize=16, margin="0.19,0.13", penwidth=1.5];
  edge [color="#315E77", fontname="Arial", fontsize=12, arrowsize=0.85, penwidth=1.5];

  presentacion [label="1 | PRESENTACIÓN\nKotlin / Room en terreno; portales Angular"];
  borde [label="2 | BORDE Y EXPOSICIÓN\nCloudFront / WAF; acceso local y Greengrass"];
  gateway [label="3 | PUERTAS DE SERVICIO\nAPI Gateway en nube; API del sitio sin enlace"];
  negocio [label="4 | NEGOCIO · LARAVEL 13 / PHP 8.5\nM1–M12; perfiles API, WMS local y trabajadores", fillcolor="#FFF1ED", color="#D4593A"];
  integracion [label="5 | INTEGRACIÓN Y EVENTOS\nRabbitMQ → SQS FIFO (JSON); colas Laravel aparte\nconsumidor PHP; ACL del ERP; hub EDI"];
  datos [label="6 | ACCESO A DATOS\nPostgreSQL / PostGIS; Aurora; S3 / Redshift\nSQLite / Room cifrado en terminales"];
  seguridad [label="7 | SEGURIDAD · ATRAVIESA LAS CAPAS\nKeycloak OIDC; caché local 24 h; PIN de turno\npolíticas por módulo, cifrado y auditoría", fillcolor="#FFF3DD", color="#AC7737"];
  observabilidad [label="8 | OBSERVABILIDAD · ATRAVIESA LAS CAPAS\nOpenTelemetry PHP / Laravel → CloudWatch\ntransaction_id; buffer local 24 h y alertas", fillcolor="#E5F2E8", color="#407553"];

  presentacion -> borde -> gateway -> negocio -> integracion -> datos;
  datos -> seguridad -> observabilidad [style=invis];
}
