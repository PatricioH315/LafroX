digraph General {
 graph [bgcolor="white",pad="0.1"]; node [shape=plain,fontname="Arial",fontsize=18];
 vista [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="6" COLOR="#AAB7C5">
 <TR><TD COLSPAN="3" BGCOLOR="#17304D"><FONT COLOR="white" POINT-SIZE="25"><B>ARQUITECTURA LÓGICA — LARAVEL / PHP</B></FONT><BR/><FONT COLOR="white">Vista general consolidada a partir del modelo de Tomás Pérez</FONT></TD></TR>
 <TR><TD WIDTH="260">Preventista · conductor<BR/>Preparador · recepción</TD><TD WIDTH="260">Calidad · rutas · gerencias<BR/>Comercial · Tesorería · TI</TD><TD WIDTH="260">Clientes · cadenas<BR/>Transportistas · proveedores</TD></TR>
 <TR><TD COLSPAN="3" BGCOLOR="#EAF2F8"><B>1. PRESENTACIÓN</B> — Kotlin / Room y HHT · Portales y consolas Angular<BR/>Terreno: 14 h · Bodega y cambios de turno: 24 h</TD></TR>
 <TR><TD><B>2. BORDE LOCAL</B><BR/>Red del sitio · control de acceso<BR/>Greengrass: frío en CD</TD><TD COLSPAN="2"><B>2. BORDE PÚBLICO</B><BR/>CloudFront · WAF · Shield · superficie AS2 separada</TD></TR>
 <TR><TD><B>3. API LOCAL</B><BR/>HHT → puerta del sitio → WMS<BR/>Validación y auditoría sin WAN</TD><TD COLSPAN="2"><B>3. API CENTRAL</B><BR/>REST API · REQUEST authorizer Keycloak<BR/>VPC Link V2 → ALB → servicio privado</TD></TR>
 <TR><TD COLSPAN="3" BGCOLOR="#FFECE5"><B>4. MONOLITO MODULAR — LARAVEL 13 / PHP 8.5</B><BR/>M1 Recepción · M2 Inventario · M3 Preventa · M4 Rutas<BR/>M5 Preparación · M6 Reparto · M7 Rendición · M8 Devoluciones<BR/>M9 Calidad · M10 Analítica · M11 Canal moderno · M12 Flota<BR/>WMS local: M1/M2/M5 + bloqueo M9 · API y trabajadores centrales aislados</TD></TR>
 <TR><TD><B>5. EVENTOS DEL SITIO</B><BR/>Outbox → RabbitMQ → shipper<BR/>UUID y orden por partición</TD><TD><B>5. INTEGRACIÓN CENTRAL</B><BR/>SQS FIFO → consumidor PHP<BR/>Trabajos Laravel en otras colas<BR/>Hub GS1 / OpenAS2 · adaptadores</TD><TD><B>CONTRAPARTES</B><BR/>ACL → ERP: único emisor DTE<BR/>Cadenas · pagos · mapas · GPS<BR/>Notificaciones</TD></TR>
 <TR><TD><B>6. DATOS LOCALES</B><BR/>Room cifrado en terminales<BR/>PostgreSQL / PostGIS por sitio</TD><TD><B>6. TRANSACCIÓN CENTRAL</B><BR/>Aurora PostgreSQL / PostGIS<BR/>Redis central · réplicas de lectura</TD><TD><B>6. OBJETOS Y ANALÍTICA</B><BR/>S3: POD / DTE · DynamoDB raw<BR/>Glue / Parquet / Redshift</TD></TR>
 <TR><TD COLSPAN="3" BGCOLOR="#FFF3DA"><B>7. SEGURIDAD TRANSVERSAL</B><BR/>Keycloak único IdP · caché local 24 h · manifiesto 26 h · PIN de turno<BR/>Permiso: bodega 8 h / terreno 14 h · KMS / secretos · TLS / mTLS · auditoría</TD></TR>
 <TR><TD COLSPAN="3" BGCOLOR="#E8F5ED"><B>8. OBSERVABILIDAD TRANSVERSAL</B><BR/>OpenTelemetry PHP / Kotlin · ADOT y alarmas locales · buffer 24 h<BR/>CloudWatch único · transaction_id · logs, métricas, trazas y alertas</TD></TR>
 <TR><TD COLSPAN="3">Lectura descendente: actores → API → regla del módulo → contrato → persistencia.<BR/>Seguridad y observabilidad atraviesan todas las capas; no son etapas finales.</TD></TR>
 </TABLE>>];
}
