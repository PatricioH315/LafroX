digraph ArquitecturaLaravel {
  graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.48", splines=polyline, fontname="Arial", fontsize=30, fontcolor="#17304D", label="ARQUITECTURA LÓGICA · PUELCHE\nLaravel 13 / PHP 8.5 · monolito modular · ocho capas", labelloc=t];
  node [shape=plain, fontname="Arial", fontsize=18];
  edge [color="#466984", penwidth=1.7, arrowsize=0.8, fontname="Arial", fontsize=15];

  actores [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="6" CELLPADDING="12" COLOR="#CDD6DF">
    <TR><TD BGCOLOR="#F1F5F8" COLSPAN="7"><B>PERSONAS Y RESPONSABILIDADES</B></TD></TR>
    <TR><TD>Preventista</TD><TD>Conductor propio<BR/>Conductor externo</TD><TD>Preparador</TD><TD>Cliente tradicional<BR/>Cliente moderno</TD><TD>Transportista</TD><TD>Proveedor</TD><TD>Calidad · Comercial · Finanzas<BR/>Planificador de rutas · TI</TD></TR>
  </TABLE>>];

  presentacion [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="6" CELLPADDING="12" COLOR="#9BB5CA">
    <TR><TD COLSPAN="7" BGCOLOR="#EAF2F8"><B>1 · PRESENTACIÓN</B></TD></TR>
    <TR><TD>App preventa<BR/>Kotlin / Room</TD><TD>App reparto<BR/>Kotlin / Room</TD><TD>Bodega / HHT<BR/>Kotlin / GS1</TD><TD>Portal clientes<BR/>Angular</TD><TD>Portal transportistas<BR/>Angular</TD><TD>Portal proveedores<BR/>Angular</TD><TD>Consolas de gestión<BR/>Angular / Tailwind</TD></TR>
    <TR><TD COLSPAN="7">Terreno: captura cifrada y eventos pendientes durante 14 h · Bodega: operación local autónoma durante 24 h</TD></TR>
  </TABLE>>];

  borde [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="6" CELLPADDING="12" COLOR="#9BB5CA">
    <TR><TD COLSPAN="3" BGCOLOR="#EAF2F8"><B>2 · BORDE Y EXPOSICIÓN</B></TD></TR>
    <TR><TD>Entrada pública<BR/>CloudFront · WAF · Shield</TD><TD>Entrada del sitio<BR/>Red local y control de acceso</TD><TD>Borde de frío<BR/>Greengrass en CD · termógrafo por BLE al terminal</TD></TR>
  </TABLE>>];

  gateway [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="6" CELLPADDING="12" COLOR="#9BB5CA">
    <TR><TD COLSPAN="2" BGCOLOR="#EAF2F8"><B>3 · PUERTAS DE SERVICIO</B></TD></TR>
    <TR><TD PORT="nube">API Gateway en nube<BR/>Integración privada / ALB hacia servicios</TD><TD PORT="local">API local del sitio<BR/>Disponible durante el corte de WAN</TD></TR>
    <TR><TD COLSPAN="2">Identidad OIDC · esquema · cuotas · versión · transaction_id</TD></TR>
  </TABLE>>];

  negocio [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="6" CELLPADDING="13" COLOR="#D8876F">
    <TR><TD COLSPAN="4" BGCOLOR="#FFECE5"><FONT POINT-SIZE="24"><B>4 · NEGOCIO — LARAVEL 13 / PHP 8.5</B></FONT><BR/>Un monolito modular · espacios PSR-4 · contratos entre dominios · Composer</TD></TR>
    <TR><TD WIDTH="260"><B>M1 · Recepción</B><BR/>OC · GS1 · lote · SSCC</TD><TD WIDTH="260"><B>M2 · Inventario</B><BR/>Stock · reserva · FEFO · conteo</TD><TD WIDTH="260"><B>M3 · Preventa</B><BR/>Pedido · precio · crédito</TD><TD WIDTH="260"><B>M4 · Rutas</B><BR/>Capacidad · ventanas · aprobación</TD></TR>
    <TR><TD><B>M5 · Preparación</B><BR/>Misiones · carga · bloqueo de frío</TD><TD><B>M6 · Reparto</B><BR/>Entrega · POD · incidencia</TD><TD><B>M7 · Rendición</B><BR/>Cobro · conciliación · descuadre</TD><TD><B>M8 · Devoluciones</B><BR/>Retorno · envases · saldo</TD></TR>
    <TR><TD><B>M9 · Calidad</B><BR/>Lote · excursión · liberación</TD><TD><B>M10 · Analítica</B><BR/>OTIF · fill rate · costo de servir</TD><TD><B>M11 · Canal moderno</B><BR/>EDI · perfil de cadena · excepciones</TD><TD><B>M12 · Flota</B><BR/>Ruta real · GPS · desviación</TD></TR>
    <TR><TD COLSPAN="4">Perfiles separados: API central · WMS local (M1/M2/M5 y reglas locales de M9) · PHP CLI / trabajadores<BR/>Cada módulo conserva su decisión y sus datos; el código compartido no habilita escrituras cruzadas.</TD></TR>
  </TABLE>>];

  integracion [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="6" CELLPADDING="12" COLOR="#9BB5CA">
    <TR><TD COLSPAN="3" BGCOLOR="#EAF2F8"><B>5 · INTEGRACIÓN Y EVENTOS</B></TD></TR>
    <TR><TD PORT="reconciliacion">RabbitMQ local · buffer 24 h<BR/>Shipper PHP → SQS FIFO<BR/>JSON canónico → consumidor PHP dedicado<BR/>Orden por partición · UUID · deduplicación</TD><TD>Colas separadas de trabajos Laravel<BR/>Workers PHP: erp-sync · EDI · avisos<BR/>Reintentos · DLQ · bandeja de excepciones<BR/>Eventos de negocio / EventBridge</TD><TD PORT="externos">ACL del ERP · frontera única<BR/>Hub EDI GS1 / AS2<BR/>Adaptadores de mapas, GPS y pagos<BR/>OpenAPI 3.1 / AsyncAPI 2.6</TD></TR>
    <TR><TD COLSPAN="3">La cola de reconciliación transporta eventos de negocio; los trabajos internos de Laravel usan otras colas.</TD></TR>
  </TABLE>>];

  externos [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="10" COLOR="#AAB3BD">
    <TR><TD BGCOLOR="#F2F3F5"><B>SISTEMAS EXTERNOS</B></TD></TR>
    <TR><TD>ERP 2017<BR/>Único emisor de DTE</TD></TR>
    <TR><TD>Cadenas · GS1 / AS2<BR/>Mapas / GPS · banco / pagos<BR/>Notificaciones</TD></TR>
  </TABLE>>];

  datos [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="6" CELLPADDING="12" COLOR="#9BB5CA">
    <TR><TD COLSPAN="3" BGCOLOR="#EAF2F8"><B>6 · ACCESO A DATOS</B></TD></TR>
    <TR><TD><B>Terreno y sitio</B><BR/>SQLite / Room cifrado en terminales<BR/>PostgreSQL / PostGIS local<BR/>Estado autoritativo del sitio durante el corte</TD><TD><B>Transacción central</B><BR/>Aurora PostgreSQL / PostGIS<BR/>PDO / Query Builder · migraciones Laravel<BR/>Redis central: caché, sin Redis local</TD><TD><B>Documentos y analítica</B><BR/>S3: evidencia y documentos<BR/>DynamoDB: ingesta IoT<BR/>Glue / Redshift: consultas y tableros</TD></TR>
    <TR><TD COLSPAN="3">Réplica DMS y aplicación de eventos con destinos y responsabilidades distintos: una operación no se aplica dos veces.</TD></TR>
  </TABLE>>];

  seguridad [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="6" CELLPADDING="12" COLOR="#BC985E">
    <TR><TD BGCOLOR="#FFF3DA"><B>7 · SEGURIDAD TRANSVERSAL — capas 1 a 6</B></TD></TR>
    <TR><TD>Keycloak: único IdP OIDC / MFA · JWT verificado por Laravel · políticas por recurso, sitio, turno y empresa<BR/>Caché local 24 h · manifiesto firmado y PIN de turno · KMS / Secrets Manager · mTLS · auditoría inmutable</TD></TR>
  </TABLE>>];

  observabilidad [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="6" CELLPADDING="12" COLOR="#70A184">
    <TR><TD BGCOLOR="#E8F5ED"><B>8 · OBSERVABILIDAD TRANSVERSAL — capas 1 a 7</B></TD></TR>
    <TR><TD>OpenTelemetry PHP / Laravel · colectores ADOT con buffer local 24 h · plataforma central CloudWatch<BR/>transaction_id de extremo a extremo · métricas, logs, trazas y alertas · saturación, edad de cola y latencia del ERP</TD></TR>
  </TABLE>>];

  actores -> presentacion [label="cada persona utiliza su superficie autorizada"];
  presentacion -> borde;
  borde -> gateway;
  gateway -> negocio [label="contratos de API; WMS disponible localmente"];
  negocio -> integracion [label="comandos y eventos; reglas del módulo propietario"];
  integracion -> datos [label="consumidores y adaptadores persisten mediante contratos"];
  negocio -> datos [constraint=false, style=dashed, label="persistencia del módulo"];
  integracion:externos -> externos [dir=both, label="contratos y acuses"];
  {rank=same; integracion; externos;}
  datos -> seguridad -> observabilidad [style=invis];
}
