<mxfile host="drawio"><diagram name="Fig_13-3_Recorrido_INN02"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="1. Incidente en terreno&lt;br&gt;C-01, C-03 o C-02 captura orden causal, reintentos y conectividad, con cupo de evidencia" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FDE8DA;strokeColor=#E8641B;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="290" height="125" as="geometry"/></mxCell><mxCell id="c2" value="2. Evidencia protegida&lt;br&gt;Capa 7 sanitiza; capa 8 correlaciona con OpenTelemetry y CloudWatch; SRE recoge el paquete" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="0" width="290" height="125" as="geometry"/></mxCell><mxCell id="c3" value="3. Admisión y reproducción&lt;br&gt;Calidad admite el caso; GitLab CI y Terraform crean recursos efímeros en QA o Preproducción" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="290" height="125" as="geometry"/></mxCell><mxCell id="c4" value="4. Corrección y contraste&lt;br&gt;Desarrollo corrige; se ejecuta el mismo paquete y se compara con el estado observado" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="290" height="125" as="geometry"/></mxCell><mxCell id="c5" value="5. Cierre comprobado&lt;br&gt;Reproducción satisfactoria, confirmación del actor de terreno y escenario de regresión permanente" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="290" height="125" as="geometry"/></mxCell><mxCell id="c6" value="6. Medición y limpieza&lt;br&gt;I-02A e I-02B: beneficio al mes 15; recursos destruidos aun si la prueba falla" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FDE8DA;strokeColor=#E8641B;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="300" width="290" height="125" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="Control: un paquete con datos prohibidos detiene la captura (I-02D). Si no reproduce la causa, se conserva el diagnóstico convencional; no se crea un sexto ambiente." style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;fillColor=#F4F4F4;" vertex="1" parent="1"><mxGeometry x="0" y="450" width="600" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>