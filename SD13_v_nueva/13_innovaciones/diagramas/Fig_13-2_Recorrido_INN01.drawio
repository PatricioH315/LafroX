<mxfile host="drawio"><diagram name="Fig_13-2_Recorrido_INN01"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="1. Datos del lote y del local&lt;br&gt;M2 Inventario, M9 Calidad y trazabilidad e historial de M3 Preventa" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FDE8DA;strokeColor=#E8641B;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="290" height="125" as="geometry"/></mxCell><mxCell id="c2" value="2. Cálculo nocturno&lt;br&gt;M10 Analítica sobre N-10: saldo estimado, reposición y vida útil" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="0" width="290" height="125" as="geometry"/></mxCell><mxCell id="c3" value="3. Aviso precargado&lt;br&gt;M3 entrega la lista a C-01 App de preventa; disponible sin señal" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="290" height="125" as="geometry"/></mxCell><mxCell id="c4" value="4. Visita al local&lt;br&gt;El preventista confirma saldo y ritmo, propone una acción autorizada y registra la respuesta" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="290" height="125" as="geometry"/></mxCell><mxCell id="c5" value="5. Retorno de la respuesta&lt;br&gt;Cola de sincronización de M3 al recuperar conexión; cierre de la acción comercial" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="290" height="125" as="geometry"/></mxCell><mxCell id="c6" value="6. Verificación del beneficio&lt;br&gt;I-01A: piloto del mes 15&lt;br&gt;I-01B e I-01C: vencimiento posentrega, sin duplicar el ahorro de bodega" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FDE8DA;strokeColor=#E8641B;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="300" width="290" height="125" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="Control: sin datos suficientes se muestra fecha y cantidad, sin predicción. El saldo no modifica el inventario oficial; la disposición sanitaria sigue en M9." style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;fillColor=#F4F4F4;" vertex="1" parent="1"><mxGeometry x="0" y="450" width="600" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>