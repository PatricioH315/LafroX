<mxfile host="drawio"><diagram name="Fig_13-6_Recorrido_INN05"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="1. Datos propios del local&lt;br&gt;Compras y productos ausentes; vencimiento de INN-01 solo con datos confirmados" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FDE8DA;strokeColor=#E8641B;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="290" height="125" as="geometry"/></mxCell><mxCell id="c2" value="2. Preparación previa a ruta&lt;br&gt;M10 Analítica sobre N-10 calcula la hoja; capa 7 limita acceso al receptor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="0" width="290" height="125" as="geometry"/></mxCell><mxCell id="c3" value="3. Visita sin internet&lt;br&gt;M3 Preventa muestra la hoja precargada y cifrada en C-01; el cliente no necesita dispositivo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="290" height="125" as="geometry"/></mxCell><mxCell id="c4" value="4. Copia si se solicita&lt;br&gt;M6 Reparto imprime en cabina y entrega con la guía en la entrega siguiente; preventista sin impresora" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="290" height="125" as="geometry"/></mxCell><mxCell id="c5" value="5. Seguimiento de cobertura&lt;br&gt;I-05A separa hojas mostradas, copias pedidas y entregadas; sin pedido, la copia espera otra entrega" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="290" height="125" as="geometry"/></mxCell><mxCell id="c6" value="6. Comprensión y efecto&lt;br&gt;I-05B antes del mes 19; cobertura al mes 27; efecto comercial estimado al mes 33" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FDE8DA;strokeColor=#E8641B;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="300" width="290" height="125" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="Control: el bloque comparativo 4 solo se activa desde mes 27 con aprobación legal, umbral de grupo y supresión; si no se aprueba, continúan los bloques 1 a 3." style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;fillColor=#F4F4F4;" vertex="1" parent="1"><mxGeometry x="0" y="450" width="600" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>