% simulacion.sty --- Shared helpers for the Sobre N. 1 documents (Art. 39).
%  Academic exercise (PUCV ICI-5444, Art. 93 of the Bases). Every page carries
%  a watermark stating that the document is a simulation with no legal value.
%  Do NOT add real institutional logos, QR codes, verification codes or seals.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{simulacion}[2026/11/22 Sobre 1 simulation helpers]

\RequirePackage{eso-pic}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{tabularx}
\RequirePackage{array}

% Folio label for the Sobre N. 1 (see lafrox.cls, section 8).
\renewcommand{\LFXfolio}{Folio}

% ---------------------------------------------------------------------------
%  Watermark: on EVERY page, including page 1.
% ---------------------------------------------------------------------------
\newcommand{\SIMtextomarca}{SIMULACIÓN ACADÉMICA --- SIN VALIDEZ LEGAL}
\AddToShipoutPictureBG{%
  \put(\LenToUnit{0.5\paperwidth},\LenToUnit{0.5\paperheight}){%
    \makebox(0,0){\rotatebox{52}{%
      \intersemibold\fontsize{34pt}{34pt}\selectfont
      \color{lafroxFuerte!11}\SIMtextomarca}}}%
  \put(\LenToUnit{0.5\paperwidth},\LenToUnit{\paperheight-0.55cm}){%
    \makebox(0,0){\fontsize{7pt}{8pt}\selectfont\color{lafroxGris}%
      Documento simulado para la Licitación N.\textdegree{} TFEP-01/2026
      (ejercicio académico PUCV ICI-5444). Datos ficticios. Sin validez legal.}}%
}

% ---------------------------------------------------------------------------
%  Document heading without cover page.
%   \SIMtitulo{code}{title}   e.g. \SIMtitulo{Formulario A-1}{Identificación...}
% ---------------------------------------------------------------------------
\newcommand{\SIMtitulo}[2]{%
  \markboth{#1}{}%
  \begin{center}
    {\fontsize{9pt}{11pt}\selectfont\color{lafroxGris}%
      \MakeUppercase{\LFXlicitacion} --- \MakeUppercase{Sobre N.\textdegree{} 1:
      Antecedentes del oferente}\par}
    \vspace{4pt}
    {\intersemibold\fontsize{15pt}{19pt}\selectfont\color{lafroxTinta}#1\par}
    \vspace{2pt}
    {\intermedium\fontsize{12pt}{15pt}\selectfont\color{lafroxTinta}%
      \MakeUppercase{#2}\par}
  \end{center}
  \vspace{6pt}%
}

% ---------------------------------------------------------------------------
%  Simulated issuer header for state/third-party certificates.
%   \SIMemisor{Issuer name (simulated)}{Document title}{Reference code}
%   The reference code must be obviously fictitious (prefix SIM-).
% ---------------------------------------------------------------------------
\newcommand{\SIMemisor}[3]{%
  \markboth{#2}{}%
  \noindent\begin{tikzpicture}
    \node[draw=lafroxGris, line width=0.6pt, dashed, inner sep=8pt,
          text width=\dimexpr\linewidth-17.2pt\relax, align=center] {%
      {\fontsize{8pt}{10pt}\selectfont\color{lafroxGris}
        EMISOR SIMULADO --- NO CORRESPONDE A UN DOCUMENTO OFICIAL\par}
      \vspace{3pt}
      {\intersemibold\fontsize{12pt}{15pt}\selectfont #1\par}
      \vspace{3pt}
      {\intermedium\fontsize{13pt}{16pt}\selectfont\MakeUppercase{#2}\par}
      \vspace{3pt}
      {\fontsize{9pt}{11pt}\selectfont Referencia: \texttt{#3}\par}
    };
  \end{tikzpicture}\par\vspace{10pt}%
}

% ---------------------------------------------------------------------------
%  Signature block of the legal representative.
%   \SIMfirma{place and date}
% ---------------------------------------------------------------------------
\newcommand{\SIMfirma}[1]{%
  \par\vspace{18pt}\noindent #1\par\vspace{34pt}
  \begin{center}
    \rule{6.4cm}{0.5pt}\\[2pt]
    {\intermedium\LFXrepresentante}\\
    {\small\LFXcargo}\\
    {\small Representante legal de \LFXempresa{} --- RUT \LFXrut}
  \end{center}\par}

% Blank form signature lines, as in the Bases (Formularios A-2 a A-6).
\newcommand{\SIMfirmaformulario}[1]{%
  \par\vspace{14pt}\noindent
  \begin{tabularx}{\linewidth}{@{}l X l l@{}}
    Nombre: & \LFXrepresentante, \LFXcargo & & \\[16pt]
    Firma:  & \rule{0.62\linewidth}{0.4pt} & Fecha: & #1 \\
  \end{tabularx}\par}

% ---------------------------------------------------------------------------
%  Fictitious notary authorization block.
%   \SIMnotario{text of the authorization}
% ---------------------------------------------------------------------------
\newcommand{\SIMnotarioNombre}{Notaría Simulada N.\textdegree{} 0 de Valparaíso}
\newcommand{\SIMnotarioTitular}{Notario Ficticio Pedro Ejemplo Muestra}
\newcommand{\SIMnotario}[1]{%
  \par\vspace{14pt}\noindent
  \begin{tikzpicture}
    \node[draw=lafroxGris, line width=0.6pt, rounded corners=3pt, inner sep=8pt,
          text width=\dimexpr\linewidth-17.2pt\relax, align=justify] {%
      {\intersemibold\small AUTORIZACIÓN NOTARIAL (SIMULADA)\par}
      \vspace{3pt}{\normalsize #1\par}
      \vspace{20pt}
      {\centering\small\rule{5cm}{0.4pt}\\ \SIMnotarioTitular\\
        \SIMnotarioNombre\\
        \textit{Timbre y firma notarial simulados --- sin sello real}\par}
    };
  \end{tikzpicture}\par}
\endinput
