eColor=#4D5656;strokeWidth=0.648;spacing=0;fontFamily=Arial;absoluteArcSize=1;arcSize=5.81;fontSize=12.321;fontColor=#FFFFFF;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="187.58" y="0.65" width="241.24" height="36.32" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;8.1 Servicios de operación&lt;/b&gt;" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#E3E6E6;strokeColor=#4D5656;strokeWidth=0.973;spacing=0;fontFamily=Arial;absoluteArcSize=1;arcSize=3.19;fontSize=12.321;fontColor=#000000;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0.49" y="82.03" width="280.15" height="26.59" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;8.1.1 Servicio de centro de operaciones 24×7&lt;/b&gt;&lt;br&gt;&lt;b&gt;y mesa de servicio durante los 36 meses de&lt;/b&gt;&lt;br&gt;&lt;b&gt;operación (04:00 a 22:00; 24×7 en&lt;/b&gt;&lt;br&gt;&lt;b&gt;septiembre y diciembre)&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#4D5656;strokeWidth=0.648;spacing=0;fontFamily=Arial;fontSize=12.321;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.57;spacingTop=0.7;" vertex="1" parent="1"><mxGeometry x="11.19" y="115.43" width="269.77" height="68.74" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;8.1.2 Servicio de gestión de incidentes,&lt;/b&gt;&lt;br&gt;&lt;b&gt;problemas y niveles de servicio del Art. 78°&lt;/b&gt;&lt;br&gt;&lt;b&gt;durante los 36 meses de operación&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#4D5656;strokeWidth=0.648;spacing=0;fontFamily=Arial;fontSize=12.321;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.57;spacingTop=3.95;" vertex="1" parent="1"><mxGeometry x="11.19" y="188.71" width="269.77" height="60.31" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;8.1.3 Servicio de continuidad y pruebas&lt;/b&gt;&lt;br&gt;&lt;b&gt;semestrales de recuperación ante desastres&lt;/b&gt;&lt;br&gt;&lt;b&gt;durante los 36 meses de operación&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#4D5656;strokeWidth=0.648;spacing=0;fontFamily=Arial;fontSize=12.321;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.57;spacingTop=3.95;" vertex="1" parent="1"><mxGeometry x="11.19" y="253.56" width="269.77" height="60.31" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;8.1.4 Actualizaciones anuales del Plan de&lt;/b&gt;&lt;br&gt;&lt;b&gt;Reversibilidad durante los 36 meses de&lt;/b&gt;&lt;br&gt;&lt;b&gt;operación&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#4D5656;strokeWidth=0.648;spacing=0;fontFamily=Arial;fontSize=12.321;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.57;spacingTop=-0.59;" vertex="1" parent="1"><mxGeometry x="11.19" y="318.41" width="269.77" height="51.23" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;8.1.5 Servicio de centro de operaciones de&lt;/b&gt;&lt;br&gt;&lt;b&gt;seguridad 24×7 con SIEM desde la primera&lt;/b&gt;&lt;br&gt;&lt;b&gt;marcha blanca (mes 13) hasta el mes 56&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#4D5656;strokeWidth=0.648;spacing=0;fontFamily=Arial;fontSize=12.321;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.57;spacingTop=-0.59;" vertex="1" parent="1"><mxGeometry x="11.19" y="374.18" width="269.77" height="51.23" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;8.1.6 Pruebas mensuales de restauración de&lt;/b&gt;&lt;br&gt;&lt;b&gt;respaldos durante los 36 meses de&lt;/b&gt;&lt;br&gt;&lt;b&gt;operación&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#4D5656;strokeWidth=0.648;spacing=0;fontFamily=Arial;fontSize=12.321;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.57;spacingTop=-5.13;" vertex="1" parent="1"><mxGeometry x="11.19" y="429.95" width="269.77" height="42.80" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;8.2 Mantenimiento&lt;/b&gt;" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#E3E6E6;strokeColor=#4D5656;strokeWidth=0.973;spacing=0;fontFamily=Arial;absoluteArcSize=1;arcSize=3.19;fontSize=12.321;fontColor=#000000;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="327.98" y="82.03" width="282.09" height="26.59" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;8.2.1 Mantenimiento correctivo y evolutivo&lt;/b&gt;&lt;br&gt;&lt;b&gt;del software durante los 36 meses de&lt;/b&gt;&lt;br&gt;&lt;b&gt;operación, con bolsa anual de horas y fuera&lt;/b&gt;&lt;br&gt;&lt;b&gt;de las ventanas de congelamiento&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#4D5656;strokeWidth=0.648;spacing=0;fontFamily=Arial;fontSize=12.321;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.57;spacingTop=5.24;" vertex="1" parent="1"><mxGeometry x="338.68" y="115.43" width="269.77" height="77.17" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;8.2.2 Mantenimiento de ciberseguridad&lt;/b&gt;&lt;br&gt;&lt;b&gt;durante los 36 meses de operación:&lt;/b&gt;&lt;br&gt;&lt;b&gt;vulnerabilidades, intrusión anual e inyección&lt;/b&gt;&lt;br&gt;&lt;b&gt;de fallas&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#4D5656;strokeWidth=0.648;spacing=0;fontFamily=Arial;fontSize=12.321;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.57;spacingTop=0.7;" vertex="1" parent="1"><mxGeometry x="338.68" y="197.14" width="269.77" height="68.74" as="geometry"/></mxCell><mxCell id="b11" value="&lt;b&gt;8.2.3 Mantenimiento del hardware durante&lt;/b&gt;&lt;br&gt;&lt;b&gt;los 36 meses de operación: sala técnica,&lt;/b&gt;&lt;br&gt;&lt;b&gt;racks, gabinetes de borde y equipamiento de&lt;/b&gt;&lt;br&gt;&lt;b&gt;terreno&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#4D5656;strokeWidth=0.648;spacing=0;fontFamily=Arial;fontSize=12.321;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.57;spacingTop=-3.19;" vertex="1" parent="1"><mxGeometry x="338.68" y="270.42" width="269.77" height="60.31" as="geometry"/></mxCell><mxCell id="b12" value="&lt;b&gt;8.2.4 Registro y reducción de la deuda&lt;/b&gt;&lt;br&gt;&lt;b&gt;técnica durante los 36 meses de operación&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#4D5656;strokeWidth=0.648;spacing=0;fontFamily=Arial;fontSize=12.321;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.57;spacingTop=2.65;" vertex="1" parent="1"><mxGeometry x="338.68" y="335.27" width="269.77" height="42.80" as="geometry"/></mxCell><mxCell id="b13" value="&lt;b&gt;8.2.5 Actualizaciones anuales de los&lt;/b&gt;&lt;br&gt;&lt;b&gt;componentes de base durante los 36 meses&lt;/b&gt;&lt;br&gt;&lt;b&gt;de operación&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#4D5656;strokeWidth=0.648;spacing=0;fontFamily=Arial;fontSize=12.321;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.57;spacingTop=-0.59;" vertex="1" parent="1"><mxGeometry x="338.68" y="382.61" width="269.77" height="51.23" as="geometry"/></mxCell><mxCell id="b14" value="&lt;b&gt;8.2.6 Revisiones semestrales de las&lt;/b&gt;&lt;br&gt;&lt;b&gt;instalaciones eléctricas de la sala durante&lt;/b&gt;&lt;br&gt;&lt;b&gt;los 36 meses de operación&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#4D5656;strokeWidth=0.648;spacing=0;fontFamily=Arial;fontSize=12.321;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.57;spacingTop=3.95;" vertex="1" parent="1"><mxGeometry x="338.68" y="438.38" width="269.77" height="60.31" as="geometry"/></mxCell><mxCell id="b15" value="&lt;b&gt;8.2.7 Ciclo de vida del equipamiento durante&lt;/b&gt;&lt;br&gt;&lt;b&gt;los 36 meses de operación: reposición y&lt;/b&gt;&lt;br&gt;&lt;b&gt;disposición final&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#4D5656;strokeWidth=0.648;spacing=0;fontFamily=Arial;fontSize=12.321;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.57;spacingTop=-0.59;" vertex="1" parent="1"><mxGeometry x="338.68" y="503.23" width="269.77" height="51.23" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>