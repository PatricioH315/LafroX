gt;&lt;b&gt;energía instalado: UPS&lt;/b&gt;&lt;br&gt;&lt;b&gt;modular N+1,&lt;/b&gt;&lt;br&gt;&lt;b&gt;generador con 24&lt;/b&gt;&lt;br&gt;&lt;b&gt;horas de autonomía,&lt;/b&gt;&lt;br&gt;&lt;b&gt;transferencia&lt;/b&gt;&lt;br&gt;&lt;b&gt;automática y PDU A/B&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#8D5524;strokeWidth=1.111;spacing=0;fontFamily=Arial;fontSize=14.444;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6.11;spacingTop=-1.3;" vertex="1" parent="1"><mxGeometry x="19.17" y="295.56" width="168.89" height="126.67" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;6.1.3 Hardware de&lt;/b&gt;&lt;br&gt;&lt;b&gt;climatización de&lt;/b&gt;&lt;br&gt;&lt;b&gt;precisión N+1&lt;/b&gt;&lt;br&gt;&lt;b&gt;instalado&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#8D5524;strokeWidth=1.111;spacing=0;fontFamily=Arial;fontSize=14.444;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6.11;spacingTop=-2.41;" vertex="1" parent="1"><mxGeometry x="19.17" y="430.00" width="168.89" height="73.33" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;6.1.4 Hardware de&lt;/b&gt;&lt;br&gt;&lt;b&gt;detección temprana de&lt;/b&gt;&lt;br&gt;&lt;b&gt;incendio y extinción&lt;/b&gt;&lt;br&gt;&lt;b&gt;por agente limpio&lt;/b&gt;&lt;br&gt;&lt;b&gt;instalado&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#8D5524;strokeWidth=1.111;spacing=0;fontFamily=Arial;fontSize=14.444;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6.11;spacingTop=-2.41;" vertex="1" parent="1"><mxGeometry x="19.17" y="511.11" width="168.89" height="87.78" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;6.1.5 Acta de&lt;/b&gt;&lt;br&gt;&lt;b&gt;recepción técnica de la&lt;/b&gt;&lt;br&gt;&lt;b&gt;sala&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#8D5524;strokeWidth=1.111;spacing=0;fontFamily=Arial;fontSize=14.444;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6.11;spacingTop=-1.3;" vertex="1" parent="1"><mxGeometry x="19.17" y="606.67" width="168.89" height="57.78" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;6.2 Cableado estructurado&lt;/b&gt;" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#EFE3D8;strokeColor=#8D5524;strokeWidth=1.667;spacing=0;fontFamily=Arial;absoluteArcSize=1;arcSize=5.47;fontSize=14.444;fontColor=#000000;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="211.95" y="116.11" width="186.67" height="45.56" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;6.2.1 Cableado de&lt;/b&gt;&lt;br&gt;&lt;b&gt;cobre Cat6A y fibra&lt;/b&gt;&lt;br&gt;&lt;b&gt;OM4 tendido, con dos&lt;/b&gt;&lt;br&gt;&lt;b&gt;ductos de ingreso&lt;/b&gt;&lt;br&gt;&lt;b&gt;independientes&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#8D5524;strokeWidth=1.111;spacing=0;fontFamily=Arial;fontSize=14.444;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6.11;spacingTop=-2.41;" vertex="1" parent="1"><mxGeometry x="230.28" y="173.33" width="168.89" height="87.78" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;6.2.2 Certificación de&lt;/b&gt;&lt;br&gt;&lt;b&gt;enlaces, etiquetado y&lt;/b&gt;&lt;br&gt;&lt;b&gt;planos as-built&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#8D5524;strokeWidth=1.111;spacing=0;fontFamily=Arial;fontSize=14.444;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6.11;spacingTop=-1.3;" vertex="1" parent="1"><mxGeometry x="230.28" y="269.44" width="168.89" height="57.78" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;6.2.3 Gabinetes de&lt;/b&gt;&lt;br&gt;&lt;b&gt;piso y switches de&lt;/b&gt;&lt;br&gt;&lt;b&gt;acceso instalados en&lt;/b&gt;&lt;br&gt;&lt;b&gt;las bodegas de Talca y&lt;/b&gt;&lt;br&gt;&lt;b&gt;Concepción&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#8D5524;strokeWidth=1.111;spacing=0;fontFamily=Arial;fontSize=14.444;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6.11;spacingTop=-2.41;" vertex="1" parent="1"><mxGeometry x="230.28" y="335.56" width="168.89" height="87.78" as="geometry"/></mxCell><mxCell id="b11" value="&lt;b&gt;6.3 Montaje de racks y&lt;/b&gt;&lt;br&gt;&lt;b&gt;gabinetes&lt;/b&gt;" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#EFE3D8;strokeColor=#8D5524;strokeWidth=1.667;spacing=0;fontFamily=Arial;absoluteArcSize=1;arcSize=5.47;fontSize=14.444;fontColor=#000000;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="423.06" y="116.11" width="186.67" height="45.56" as="geometry"/></mxCell><mxCell id="b12" value="&lt;b&gt;6.3.1 Rack R01 de&lt;/b&gt;&lt;br&gt;&lt;b&gt;servidores montado:&lt;/b&gt;&lt;br&gt;&lt;b&gt;clúster de tres nodos,&lt;/b&gt;&lt;br&gt;&lt;b&gt;respaldo local,&lt;/b&gt;&lt;br&gt;&lt;b&gt;consola KVM y&lt;/b&gt;&lt;br&gt;&lt;b&gt;traslado del servidor&lt;/b&gt;&lt;br&gt;&lt;b&gt;del ERP del CLIENTE&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#8D5524;strokeWidth=1.111;spacing=0;fontFamily=Arial;fontSize=14.444;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6.11;spacingTop=-2.41;" vertex="1" parent="1"><mxGeometry x="441.39" y="173.33" width="168.89" height="122.22" as="geometry"/></mxCell><mxCell id="b13" value="&lt;b&gt;6.3.2 Rack R02 de&lt;/b&gt;&lt;br&gt;&lt;b&gt;comunicaciones&lt;/b&gt;&lt;br&gt;&lt;b&gt;montado: firewalls,&lt;/b&gt;&lt;br&gt;&lt;b&gt;switches de núcleo y&lt;/b&gt;&lt;br&gt;&lt;b&gt;de gestión, y&lt;/b&gt;&lt;br&gt;&lt;b&gt;distribución de fibra&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#8D5524;strokeWidth=1.111;spacing=0;fontFamily=Arial;fontSize=14.444;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6.11;spacingTop=-1.3;" vertex="1" parent="1"><mxGeometry x="441.39" y="303.33" width="168.89" height="109.44" as="geometry"/></mxCell><mxCell id="b14" value="&lt;b&gt;6.3.3 Gabinete de&lt;/b&gt;&lt;br&gt;&lt;b&gt;borde de Concepción&lt;/b&gt;&lt;br&gt;&lt;b&gt;montado: servidores&lt;/b&gt;&lt;br&gt;&lt;b&gt;activo y en espera,&lt;/b&gt;&lt;br&gt;&lt;b&gt;firewalls, switches,&lt;/b&gt;&lt;br&gt;&lt;b&gt;UPS, climatización y&lt;/b&gt;&lt;br&gt;&lt;b&gt;monitoreo&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#8D5524;strokeWidth=1.111;spacing=0;fontFamily=Arial;fontSize=14.444;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6.11;spacingTop=-3.52;" vertex="1" parent="1"><mxGeometry x="441.39" y="420.56" width="168.89" height="120.67" as="geometry"/></mxCell><mxCell id="b15" value="&lt;b&gt;6.3.4 Gabinetes de&lt;/b&gt;&lt;br&gt;&lt;b&gt;borde montados en&lt;/b&gt;&lt;br&gt;&lt;b&gt;Curicó, Chillán y Los&lt;/b&gt;&lt;br&gt;&lt;b&gt;Ángeles, con dos&lt;/b&gt;&lt;br&gt;&lt;b&gt;mini-PC (activo y en&lt;/b&gt;&lt;br&gt;&lt;b&gt;espera) por&lt;/b&gt;&lt;br&gt;&lt;b&gt;plataforma&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#8D5524;strokeWidth=1.111;spacing=0;fontFamily=Arial;fontSize=14.444;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6.11;spacingTop=-2.41;" vertex="1" parent="1"><mxGeometry x="441.39" y="549.00" width="168.89" height="125.56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>