archa blanca&lt;br&gt;(mes 13) hasta el mes 56" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#4D5656;strokeWidth=0.619;spacing=0;fontFamily=Arial;fontSize=6.811;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.41;spacingTop=6.86;" vertex="1" parent="1"><mxGeometry x="5116.28" y="436.51" width="94.11" height="57.17" as="geometry"/></mxCell><mxCell id="b252" value="&lt;b&gt;8.1.6&lt;/b&gt; Pruebas mensuales de&lt;br&gt;restauración de respaldos&lt;br&gt;durante los 36 meses de&lt;br&gt;operación" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#4D5656;strokeWidth=0.619;spacing=0;fontFamily=Arial;fontSize=6.811;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.41;spacingTop=2.53;" vertex="1" parent="1"><mxGeometry x="5116.28" y="498.01" width="94.11" height="40.86" as="geometry"/></mxCell><mxCell id="b253" value="&lt;b&gt;8.2 Mantenimiento&lt;/b&gt;" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#E3E6E6;strokeColor=#4D5656;strokeWidth=0.929;spacing=0;fontFamily=Arial;absoluteArcSize=1;arcSize=2.01;fontSize=7.43;fontColor=#000000;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="5223.70" y="157.58" width="104.02" height="16.72" as="geometry"/></mxCell><mxCell id="b254" value="&lt;b&gt;8.2.1&lt;/b&gt; Mantenimiento&lt;br&gt;correctivo y evolutivo del&lt;br&gt;software durante los 36&lt;br&gt;meses de operación, con&lt;br&gt;bolsa anual de horas y fuera&lt;br&gt;de las ventanas de&lt;br&gt;congelamiento" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#4D5656;strokeWidth=0.619;spacing=0;fontFamily=Arial;fontSize=6.811;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.41;spacingTop=6.86;" vertex="1" parent="1"><mxGeometry x="5233.92" y="180.79" width="94.11" height="73.68" as="geometry"/></mxCell><mxCell id="b255" value="&lt;b&gt;8.2.2&lt;/b&gt; Mantenimiento de&lt;br&gt;ciberseguridad dura