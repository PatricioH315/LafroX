fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.51;spacingTop=-2.8;" vertex="1" parent="1"><mxGeometry x="11.03" y="146.34" width="97.13" height="50.48" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;1.1.3 Acta de&lt;/b&gt;&lt;br&gt;&lt;b&gt;confirmación con el&lt;/b&gt;&lt;br&gt;&lt;b&gt;CLIENTE de la fecha&lt;/b&gt;&lt;br&gt;&lt;b&gt;de inicio, la evidencia&lt;/b&gt;&lt;br&gt;&lt;b&gt;para el proveedor de&lt;/b&gt;&lt;br&gt;&lt;b&gt;lácteos, las ventanas&lt;/b&gt;&lt;br&gt;&lt;b&gt;de paso a producción&lt;/b&gt;&lt;br&gt;&lt;b&gt;y el acuse tributario&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=0.639;spacing=0;fontFamily=Arial;fontSize=8.308;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.51;spacingTop=0.39;" vertex="1" parent="1"><mxGeometry x="11.03" y="201.30" width="97.13" height="88.19" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;1.2 Alcance del proyecto&lt;/b&gt;" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#DCE6F1;strokeColor=#1F4E79;strokeWidth=0.959;spacing=0;fontFamily=Arial;absoluteArcSize=1;arcSize=2.07;fontSize=8.308;fontColor=#000000;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="121.90" y="66.78" width="107.36" height="17.25" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;1.2.1 Documento de&lt;/b&gt;&lt;br&gt;&lt;b&gt;especificación de&lt;/b&gt;&lt;br&gt;&lt;b&gt;requerimientos y línea&lt;/b&gt;&lt;br&gt;&lt;b&gt;base de alcance de la&lt;/b&gt;&lt;br&gt;&lt;b&gt;Etapa 1 (H1)&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=0.639;spacing=0;fontFamily=Arial;fontSize=8.308;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.51;spacingTop=-2.8;" vertex="1" parent="1"><mxGeometry x="132.44" y="90.74" width="97.13" height="50.48" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;1.2.2 Documento de&lt;/b&gt;&lt;br&gt;&lt;b&gt;reglas de ruteo&lt;/b&gt;&lt;br&gt;&lt;b&gt;capturadas al&lt;/b&gt;&lt;br&gt;&lt;b&gt;planificador de rutas&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=0.639;spacing=0;fontFamily=Arial;fontSize=8.308;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.51;spacingTop=-2.8;" vertex="1" parent="1"><mxGeometry x="132.44" y="145.70" width="97.13" height="42.18" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;1.2.3 Documento de&lt;/b&gt;&lt;br&gt;&lt;b&gt;especificación de las&lt;/b&gt;&lt;br&gt;&lt;b&gt;interfaces sin&lt;/b&gt;&lt;br&gt;&lt;b&gt;documentación del&lt;/b&gt;&lt;br&gt;&lt;b&gt;ERP, del WMS de 2013&lt;/b&gt;&lt;br&gt;&lt;b&gt;y de la telemetría del&lt;/b&gt;&lt;br&gt;&lt;b&gt;tercero&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=0.639;spacing=0;fontFamily=Arial;fontSize=8.308;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.51;spacingTop=1.03;" vertex="1" parent="1"><mxGeometry x="132.44" y="192.35" width="97.13" height="78.60" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;1.2.4 Matriz de&lt;/b&gt;&lt;br&gt;&lt;b&gt;trazabilidad:&lt;/b&gt;&lt;br&gt;&lt;b&gt;requerimiento,&lt;/b&gt;&lt;br&gt;&lt;b&gt;módulo, paquete y&lt;/b&gt;&lt;br&gt;&lt;b&gt;prueba (H1)&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=0.639;spacing=0;fontFamily=Arial;fontSize=8.308;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=3.51;spacingTop=-0.89;" vertex="1" parent="1"><mxGeometry x="132.44" y="275.43" width="97.13" height="54.32" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;1.2.5 Documento de&lt;/b&gt;&lt;br&gt;&lt;b&gt;línea base de alcance&lt;/b&gt;&lt;br&gt;&lt;b&gt;de la Etapa 2: canal&lt;/b&gt;&lt;br&gt;&lt;b&gt;moderno y costo de&lt;/b&gt;&lt;br&gt;&lt;b&gt;servir (H8)&lt;/b&gt;" sty