="1"><mxGeometry x="14.48" y="135.12" width="172.89" height="78.05" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;7.1.2 Programa de&lt;/b&gt;&lt;br&gt;&lt;b&gt;capacitación continua del&lt;/b&gt;&lt;br&gt;&lt;b&gt;turno de noche por la&lt;/b&gt;&lt;br&gt;&lt;b&gt;rotación del 38 %&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=0.839;spacing=0;fontFamily=Arial;fontSize=11.75;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=4.62;spacingTop=-5.06;" vertex="1" parent="1"><mxGeometry x="14.48" y="219.04" width="172.89" height="55.39" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;7.1.3 Incorporación de&lt;/b&gt;&lt;br&gt;&lt;b&gt;conductores de&lt;/b&gt;&lt;br&gt;&lt;b&gt;transportistas, escaneos y&lt;/b&gt;&lt;br&gt;&lt;b&gt;lectura del rojo&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=0.839;spacing=0;fontFamily=Arial;fontSize=11.75;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=4.62;spacingTop=0.82;" vertex="1" parent="1"><mxGeometry x="14.48" y="280.31" width="172.89" height="66.30" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;7.1.4 Traspaso al equipo de&lt;/b&gt;&lt;br&gt;&lt;b&gt;TI de cuatro personas del&lt;/b&gt;&lt;br&gt;&lt;b&gt;CLIENTE&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=0.839;spacing=0;fontFamily=Arial;fontSize=11.75;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=4.62;spacingTop=-4.22;" vertex="1" parent="1"><mxGeometry x="14.48" y="352.49" width="172.89" height="43.64" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;7.1.5 Materiales de&lt;/b&gt;&lt;br&gt;&lt;b&gt;capacitación: manuales por&lt;/b&gt;&lt;br&gt;&lt;b&gt;perfil, guías rápidas,&lt;/b&gt;&lt;br&gt;&lt;b&gt;preguntas frecuentes y&lt;/b&gt;&lt;br&gt;&lt;b&gt;videos tutoriales&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=0.839;spacing=0;fontFamily=Arial;fontSize=11.75;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=4.62;spacingTop=-0.02;" vertex="1" parent="1"><mxGeometry x="14.48" y="416.27" width="172.89" height="78.05" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;7.1.6 Plataforma de&lt;/b&gt;&lt;br&gt;&lt;b&gt;autoformación en línea con&lt;/b&gt;&lt;br&gt;&lt;b&gt;registro de avance&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=0.839;spacing=0;fontFamily=Arial;fontSize=11.75;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=4.62;spacingTop=-4.22;" vertex="1" parent="1"><mxGeometry x="14.48" y="500.19" width="172.89" height="43.64" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;7.2 Gestión del cambio&lt;/b&gt;" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#D8F0EB;strokeColor=#148F77;strokeWidth=1.259;spacing=0;fontFamily=Arial;absoluteArcSize=1;arcSize=2.72;fontSize=11.75;fontColor=#000000;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="213.80" y="91.90" width="189.67" height="22.66" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;7.2.1 Acompañamiento del&lt;/b&gt;&lt;br&gt;&lt;b&gt;personal con 20 o 30 años en&lt;/b&gt;&lt;br&gt;&lt;b&gt;la compañía&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=0.839;spacing=0;fontFamily=Arial;fontSize=11.75;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=4.62;spacingTop=-4.22;" vertex="1" parent="1"><mxGeometry x="227.65" y="123.37" width="176.24" height="43.64" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;7.2.2 Gestión del cambio con&lt;/b&gt;&lt;br&gt;&lt;b&gt;las cadenas y los&lt;/b&gt;&lt;br&gt;&lt;b&gt;transportistas&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=0.839;spacing=0;fontFamily=Arial;fontSize=11.75;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=4.62;spacingTop=-4.22;" vertex="1" parent="1"><mxGeometry x="227.65" y="172.89" width="176.24" height="43.64" as="geometry"/></mxCell><mxCell id="b11" value="&lt;b&gt;7.2.3 Diagnóstico del impacto&lt;/b&gt;&lt;br&gt;&lt;b&gt;organizacional por área y&lt;/b&gt;&lt;br&gt;&lt;b&gt;perfil, con agentes de cambio&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=0.839;spacing=0;fontFamily=Arial;fontSize=11.75;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=4.62;spacingTop=1.66;" vertex="1" parent="1"><mxGeometry x="227.65" y="222.40" width="176.24" height="55.39" as="geometry"/></mxCell><mxCell id="b12" value="&lt;b&gt;7.2.4 Procedimientos&lt;/b&gt;&lt;br&gt;&lt;b&gt;operativos rediseñados,&lt;/b&gt;&lt;br&gt;&lt;b&gt;contingencia de frío y&lt;/b&gt;&lt;br&gt;&lt;b&gt;ruptura confirmada&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=0.839;spacing=0;fontFamily=Arial;fontSize=11.75;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=4.62;spacingTop=1.66;" vertex="1" parent="1"><mxGeometry x="227.65" y="283.67" width="176.24" height="69.66" as="geometry"/></mxCell><mxCell id="b13" value="&lt;b&gt;7.2.5 Medición de la adopción&lt;/b&gt;&lt;br&gt;&lt;b&gt;y plan de acción correctiva&lt;/b&gt;" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=#FFFFFF;strokeColor=#148F77;strokeWidth=0.839;spacing=0;fontFamily=Arial;fontSize=11.75;fontColor=#000000;fontStyle=0;align=left;verticalAlign=top;spacingLeft=4.62;spacingTop=3.34;" vertex="1" parent="1"><mxGeometry x="227.65" y="359.20" width="176.24" height="43.64" as="geometry"/></mxCell><mxCell id="b14" value="&lt;b&gt;7.3 Evaluaciones y&lt;/b&gt;&lt;br&gt;&lt;b&gt;certificaciones&lt;/b&gt;" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#D8F0EB;strokeColor=#148F7