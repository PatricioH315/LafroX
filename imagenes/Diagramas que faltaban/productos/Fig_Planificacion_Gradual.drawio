        </mxCell>
        <mxCell id="t2_d" value="&lt;b&gt;Detalle por plantilla de clase (Tabla 20):&lt;/b&gt; módulos D, integraciones I, diseños E, instalaciones/capacitaciones T y pruebas ampliadas V detallados antes de construir (8 a 80 HH, quincena)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1.0;fontFamily=Arial;fontSize=12.2;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="10.00" y="272.00" width="564.00" height="52.00" as="geometry" />
        </mxCell>
        <mxCell id="t2_h" value="&lt;b&gt;Hitos de control en el tramo: H3 (mes 6 · infraestructura/nube), H4 (mes 10 · QA E1) y H5 (mes 12 · certificación E1).&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=12.2;fontColor=#21699B;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="10.00" y="330.00" width="564.00" height="28.00" as="geometry" />
        </mxCell>
        <mxCell id="t3_t" value="&lt;b&gt;Horizonte 3 · Posteriores al H5 (desde el mes 13)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F7460;strokeColor=#0F7460;strokeWidth=1.0;fontFamily=Arial;fontSize=12.4;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="10.00" y="396.00" width="344.00" height="32.00" as="geometry" />
        </mxCell>
        <mxCell id="t3_b" value="&lt;b&gt;35 paquetes · gradual&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F7460;strokeWidth=1.3;fontFamily=Arial;fontSize=12.2;fontColor=#0F7460;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="362.00" y="396.00" width="212.00" height="32.00" as="geometry" />
        </mxCell>
        <mxCell id="t3_d" value="&lt;b&gt;Paquete de planificación gradual:&lt;/b&gt; fechas, holguras y dependencias fijadas en línea base (Tablas 13 y 17). El líder de frente detalla las actividades de 8 a 80 HH antes de ejecutar, con aprobación del Comité de Proyecto y sin mover hitos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1.0;fontFamily=Arial;fontSize=12.2;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="10.00" y="434.00" width="564.00" height="70.00" as="geometry" />
        </mxCell>
        <mxCell id="t3_h" value="&lt;b&gt;Hitos: H6 (m13), H8 (m14), H7 (m16), H9 (m17), H10 (m18), H11 (m19), H12 (m21) y cierre 1.7.9 (07‑11‑2028, m22).&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=12.2;fontColor=#0F7460;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="10.00" y="510.00" width="564.00" height="34.00" as="geometry" />
        </mxCell>
        <mxCell id="t_cont" value="&lt;b&gt;Paquetes de esfuerzo continuo (59 paquetes · meses 1 a 56, Tabla 21)&lt;/b&gt;&lt;br&gt;Gobierno, marchas blancas (9.2.1–9.2.2), estabilización (9.3.1–9.3.2) y 36 meses de Operación (Producto 10): relevos quincenales de hasta 64 HH (nivel de esfuerzo) u ocurrencias de hasta 80 HH (p. ej., 9.5.4 y 9.5.5)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3E6E6;strokeColor=#4D5656;strokeWidth=1.5;fontFamily=Arial;arcSize=8;fontSize=12.2;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" vertex="1" parent="1">
