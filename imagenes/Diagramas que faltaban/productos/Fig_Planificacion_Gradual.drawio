        </mxCell>
        <mxCell id="t1_d" value="&lt;b&gt;Detalle inmediato en actividades (Tablas 18 y 19):&lt;/b&gt; paquetes de inicio, alcance, diseño y compras tempranas descompuestos en actividades de 8 a 80 HH dentro de una quincena (máximo 10 días hábiles)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5D8DC;strokeWidth=1.0;fontFamily=Arial;fontSize=12.2;fontColor=#111111;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
