<mxfile host="drawio"><diagram name="Fig_13-4_Recorrido_INN03"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="1. Historia por tramo&lt;br&gt;B-01: cámara; B-03: camión. Cada lote se asocia al sensor por lugar y tiempo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FDE8DA;strokeColor=#E8641B;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="290" height="125" as="geometry"/></mxCell><mxCell id="c2" value="2. Captura sin enlace&lt;br&gt;B-02 acumula carga en cámara; C-02 alerta en ruta y descarga el registro completo al retorno" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="0" width="290" height="125" as="geometry"/></mxCell><mxCell id="c3" value="3. Ingesta y asociación&lt;br&gt;N-08 y N-06 reciben series; capa 5 enlaza eventos EPCIS y datos del sensor con el lote" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="290" height="125" as="geometry"/></mxCell><mxCell id="c4" value="4. Estimación versionada&lt;br&gt;M10 sobre N-10 integra el modelo cinético por familia; parámetros aprobados por Calidad" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="290" height="125" as="geometry"/></mxCell><mxCell id="c5" value="5. Disposición y consumo&lt;br&gt;M9 presenta la evidencia a Calidad; M2 y M5 reciben sugerencia por familia; innovación 1 usa la estimación" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="290" height="125" as="geometry"/></mxCell><mxCell id="c6" value="6. Validación y recalibración&lt;br&gt;I-03B: contraste con Calidad en el piloto; paquete 8.3.2: revisión semestral" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FDE8DA;strokeColor=#E8641B;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="300" width="290" height="125" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="Control: no se rellenan tramos sin datos ni se alarga la fecha impresa. La estimación no sustituye la regla graduada, el bloqueo ni el FEFO obligatorio." style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;fillColor=#F4F4F4;" vertex="1" parent="1"><mxGeometry x="0" y="450" width="600" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>