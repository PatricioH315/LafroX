<mxfile host="drawio"><diagram name="Fig_13-5_Recorrido_INN04"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="1. Hechos de la operación&lt;br&gt;M6 Reparto, M7 Cobranza y rendición y M8 Devoluciones y envases aportan entregas y retornos" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FDE8DA;strokeColor=#E8641B;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="290" height="125" as="geometry"/></mxCell><mxCell id="c2" value="2. Referencia comparable&lt;br&gt;N-10 conserva canasta y línea base de meses 21 a 23; índices y regla estacional documentados" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="0" width="290" height="125" as="geometry"/></mxCell><mxCell id="c3" value="3. Cálculo de desempeño&lt;br&gt;M10 Analítica obtiene costo comparable y OTIF, sin excluir entregas fallidas del denominador" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="290" height="125" as="geometry"/></mxCell><mxCell id="c4" value="4. Ensayo sin pago&lt;br&gt;Finanzas reproduce tres liquidaciones en sombra en meses 21 a 23; I-04B exige 3 de 3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="290" height="125" as="geometry"/></mxCell><mxCell id="c5" value="5. Liquidación desde mes 24&lt;br&gt;Tramo variable acotado, solo con OTIF vigente cumplido; capa 7 audita y ERP conserva dato definitivo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="290" height="125" as="geometry"/></mxCell><mxCell id="c6" value="6. Acompañamiento y efecto&lt;br&gt;Comercial decide la recomendación de malla; se registra respuesta; I-04A se verifica al mes 36" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FDE8DA;strokeColor=#E8641B;fontColor=#111111;arcSize=8;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="300" width="290" height="125" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=14;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="Control: no se compensan multas ni se supera el máximo. Si no rinde, se vuelve a la estructura de pago de las Bases; el costo de servir obligatorio permanece." style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;arcSize=8;spacing=8;fillColor=#F4F4F4;" vertex="1" parent="1"><mxGeometry x="0" y="450" width="600" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>