        <mxCell id="H3MXmKs3qDEITmta8l65-695" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#334155;" value="Salida hacia AWS · VPN IPsec, siempre saliente" vertex="1">
