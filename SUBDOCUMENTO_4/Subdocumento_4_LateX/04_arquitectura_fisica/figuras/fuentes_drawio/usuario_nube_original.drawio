        <mxCell id="H3MXmKs3qDEITmta8l65-630" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;rounded=0;fontSize=10;fontColor=#1e293b;" value="&lt;b&gt;Gabinete cerrado IP40&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Rango industrial de −20 °C a +60 °C&lt;/font&gt;" vertex="1">
