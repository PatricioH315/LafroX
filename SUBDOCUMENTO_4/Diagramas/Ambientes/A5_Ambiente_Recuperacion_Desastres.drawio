mxCell id="n16" value="us-east-1 · ≈ 7.700 km de la primaria" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=16;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;spacingBottom=6;fontColor=#00A4A6;dashed=1;" vertex="1" parent="1"><mxGeometry x="360" y="165" width="480" height="335" as="geometry"/></mxCell><mxCell id="n17" value="VPC Recuperación · 10.201.0.0/16" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=16;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;spacingBottom=6;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="1"><mxGeometry x="380" y="230" width="440" height="230" as="geometry"/></mxCell><mxCell id="n18" value="ECS Fargate (N-04)&lt;br&gt;réplica reducida" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=15;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;whiteSpace=wrap;labelWidth=200;" vertex="1" parent="1"><mxGeometry x="580" y="320" width="56" height="56" as="geometry"/></mxCell><mxCell id="n19" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D6246E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="546" y="310" width="30" height="30" as="geometry"/></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n7" target="n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="On-premise · sitio de recuperación" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=16;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;spacingBottom=6;fontColor=#7D8998;dashed=0;" vertex="1" parent="1"><mxGeometry x="930" y="80" width="440" height="460" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;CD Talca&lt;/b&gt;&lt;br&gt;VM-01: wms_only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6F6;strokeColor=#545B64;fontSize=14;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="950" y="170" width="400" height="70" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;CD Concepción&lt;/b&gt;&lt;br&gt;VM-C01: wms_only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6F6;strokeColor=#545B64;fontSize=14;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="950" y="420" width="400" height="70" as="geometry"/></mxCell><mxCell id="n24" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D6246E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="916" y="410" width="30" height="30" as="geometry"/></mxCell><mxCell id="n25" value="DRP local" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n22" target="n23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n26" value="&lt;b&gt;Secuencia de despliegue&lt;/b&gt;&lt;table style=&quot;font-size:14px;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;GitLab CI orquesta el pipeline; cada cambio instala sus dependencias según composer.lock y pasa por los controles (RT-04.05)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;2&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;AWS CodeBuild construye cada imagen de forma hermética, con procedencia SLSA nivel 3; el pipeline bloquea ante un hallazgo crítico o alto, un contrato público roto sin versión nueva o una cobertura inferior al 70 % (RT-04.11)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;La imagen aprobada se firma, se publica en Elastic Container Registry y se promueve por su digest, de modo que ningún ambiente recompila&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;La réplica reducida de us-east-1 recibe cada versión liberada en Producción desde el mismo ECR de sa-east-1, de modo que la plataforma que se promueve en una conmutación corre la misma versión&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;Si la contingencia afecta solo a la bodega de Talca, el WMS de Concepción (VM-C01), que ya corre la misma imagen, asume su carga con un RTO adicional de 1 a 2 horas&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4F6F6;strokeColor=#545B64;fontSize=15;fontColor=#232F3E;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="1040" height="233" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>