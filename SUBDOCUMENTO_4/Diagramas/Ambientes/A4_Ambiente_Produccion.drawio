F6;strokeColor=#545B64;fontSize=14;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1560" y="270" width="430" height="100" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;Cross-docking (3) · E-01 WMS de cross-docking&lt;/b&gt;&lt;br&gt;Docker Compose: wms_only, shipper, PostgreSQL, RabbitMQ y caché de identidad" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6F6;strokeColor=#545B64;fontSize=14;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1560" y="400" width="430" height="100" as="geometry"/></mxCell><mxCell id="n37" value="Primera instalación de cada versión: sitio por sitio" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=14;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1560" y="540" width="430" height="50" as="geometry"/></mxCell><mxCell id="n38" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D6246E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1526" y="530" width="30" height="30" as="geometry"/></mxCell><mxCell id="n39" value="Contenedores de la misma imagen; infraestructura de cada sitio declarada como código versionado" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6F6;strokeColor=#545B64;fontSize=14;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1560" y="610" width="430" height="70" as="geometry"/></mxCell><mxCell id="n40" value="migraciones de esquema" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="n6" target="n22"><mxGeometry x="0.25" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n41" value="azul-verde con canario" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="n6" target="n20"><mxGeometry x="0.25" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n42" value="misma imagen desde ECR por la VPN (VPC Hub) y los endpoints de interfaz de la VPC de Producción; Ansible (F-02) actualiza los contenedores" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=13;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n6" target="n37"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="14" y="508"/><mxPoint x="14" y="830"/><mxPoint x="1520" y="830"/><mxPoint x="1520" y="565"/></Array></mxGeometry></mxCell><mxCell id="n43" value="&lt;b&gt;Secuencia de despliegue&lt;/b&gt;&lt;table style=&quot;font-size:13px;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 6px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;GitLab CI orquesta el cambio y ejecuta los controles; bloquea ante hallazgos críticos o altos (RT-04.05)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 6px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;2&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;AWS CodeBuild construye la imagen de forma hermética (SLSA nivel 3)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 6px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;Amazon ECR guarda la imagen firmada; se promueve por su digest, sin recompilar&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 6px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;Migraciones Laravel aditivas y reversibles, antes de cambiar el tráfico (RT-04.10)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 6px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;Despliegue azul-verde con canario en ECS Fargate; paso automático sin intervención manual (RT-04.06, RT-04.07)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 6px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;6&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;Publicación de los portales Angular en S3 privado y CloudFront&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 6px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;7&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;Sitios on-premise: descarga desde ECR por la VPN (VPC Hub) y los endpoints de interfaz; Ansible (F-02) actualiza los contenedores, sitio por sitio&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4F6F6;strokeColor=#545B64;fontSize=14;fontColor=#232F3E;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="720" height="254" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>