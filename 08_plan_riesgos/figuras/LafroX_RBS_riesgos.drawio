ivos&lt;br&gt;&lt;font style=&quot;font-size:40px&quot;&gt;R-033 · Media&lt;/font&gt;" vertex="1"><mxGeometry height="199" width="440" x="3340" y="1003" as="geometry" /></mxCell><mxCell id="e33" edge="1" parent="1" source="b6" style="edgeStyle=orthogonalEdgeStyle;exitX=0.0500;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;html=1;endArrow=none;rounded=0;strokeColor=#666666;strokeWidth=3;" target="n6.2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="root" parent="1" style="html=1;whiteSpace=wrap;align=left;spacingLeft=25;spacingRight=18;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=3;fontColor=#000000;fontSize=58;align=center;" value="&lt;b&gt;Riesgos del proyecto LafroX&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:43px&quot;&gt;40 riesgos · 5 críticos · 9 altos · 17 medios · 9 bajos&lt;/font&gt;" vertex="1"><mxGeometry height="184" width="1500" x="1160" y="40" as="geometry" /></mxCell><mxCell id="e34" edge="1" parent="1" source="root" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;endArrow=none;rounded=0;strokeColor=#666666;strokeWidth=3;" target="b1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e35" edge="1" parent="1" source="root" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;endArrow=none;rounded=0;strokeColor=#666666;strokeWidth=3;" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e36" edge="1" parent="1" source="root" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;endArrow=none;rounded=0;strokeColor=#666666;strokeWidth=3;" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e37" edge="1" parent="1" source="root" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;endArrow=none;rounded=0;strokeColor=#666666;strokeWidth=3;" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e38" edge="1" parent="1" source="root" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;endArr