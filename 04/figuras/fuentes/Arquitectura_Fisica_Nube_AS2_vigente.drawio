<mxfile host="app.diagrams.net"><diagram id="nube-as2" name="Nube y borde AS2"><mxGraphModel page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="region" parent="1" vertex="1" value="AWS sa-east-1 · VPC Producción · dos zonas: sa-east-1a / sa-east-1b" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#EDF6FA;strokeColor=#555555;fontColor=#111111;spacing=6;verticalAlign=top;align=left;fontStyle=1;dashed=1;"><mxGeometry x="0" y="270" width="800" height="420" as="geometry" /></mxCell><mxCell id="apps" parent="1" vertex="1" value="Personas externas&lt;br&gt;EC55 / TC58e y portales" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="0" y="0" width="250" height="75" as="geometry" /></mxCell><mxCell id="chains" parent="1" vertex="1" value="Cadenas de supermercados&lt;br&gt;Mensajes AS2 y MDN" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="275" y="0" width="250" height="75" as="geometry" /></mxCell><mxCell id="office" parent="1" vertex="1" value="Oficinas y teletrabajo&lt;br&gt;Consolas y administración" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="550" y="0" width="250" height="75" as="geometry" /></mxCell><mxCell id="web" parent="1" vertex="1" value="Borde web global&lt;br&gt;Route 53 · CloudFront&lt;br&gt;WAF · Shield Advanced&lt;br&gt;S3 portales privado" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="0" y="105" width="250" height="125" as="geometry" /></mxCell><mxCell id="as2edge" parent="1" vertex="1" value="Borde AS2 global&lt;br&gt;CloudFront / WAF / Shield&lt;br&gt;Sin caché ni CAPTCHA&lt;br&gt;MIME y firma intactos" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FDE8DA;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="275" y="105" width="250" height="125" as="geometry" /></mxCell><mxCell id="va" parent="1" vertex="1" value="Acceso de personal&lt;br&gt;Verified Access&lt;br&gt;Identidad, MFA y postura&lt;br&gt;Sin consola pública" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="550" y="105" width="250" height="125" as="geometry" /></mxCell><mxCell id="app" parent="1" vertex="1" value="API REST + autorizador&lt;br&gt;ALB privado → Fargate&lt;br&gt;Perfiles en dos zonas&lt;br&gt;OIDC público → Keycloak" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="10" y="320" width="250" height="150" as="geometry" /></mxCell><mxCell id="as2" parent="1" vertex="1" value="ALB de origen AS2&lt;br&gt;Solo CloudFront + secreto&lt;br&gt;TLS 1.3 en cada tramo&lt;br&gt;OpenAS2: 2 tareas / 2 AZ&lt;br&gt;Firma, cifrado y MDN" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FDE8DA;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="275" y="320" width="250" height="150" as="geometry" /></mxCell><mxCell id="console" parent="1" vertex="1" value="Consolas en ALB privado&lt;br&gt;Angular: 2 tareas / 2 AZ&lt;br&gt;API privada / execute-api&lt;br&gt;Keycloak privado (admin)&lt;br&gt;OIDC público solo usuario" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="540" y="320" width="250" height="150" as="geometry" /></mxCell><mxCell id="data" parent="1" vertex="1" value="Aurora escritor/lector · ElastiCache primario/réplica · DMS desde VM-02&lt;br&gt;Frío: IoT Core + CloudConnect/SQS → M9, no por portales&lt;br&gt;DynamoDB · S3 datos · SQS FIFO · SNS · ECR&lt;br&gt;Analítica: S3 → Glue → Redshift Serverless → QuickSight" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="10" y="510" width="780" height="140" as="geometry" /></mxCell><mxCell id="dr" parent="1" vertex="1" value="AWS us-east-1 · Recuperación&lt;br&gt;&lt;br&gt;Aurora secundaria · DynamoDB · S3&lt;br&gt;Datos replicados; GPS no se replica&lt;br&gt;&lt;br&gt;API, Lambda, ALB, Fargate,&lt;br&gt;Keycloak, AS2 y Verified Access&lt;br&gt;se restituyen y validan antes&lt;br&gt;de redirigir el borde global&lt;br&gt;&lt;br&gt;Transit Gateway · VPN · Backup&lt;br&gt;SQS · SNS · ECR&lt;br&gt;RTO ≤4 h · RPO ≤15 min" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#EDF6FA;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="840" y="270" width="350" height="420" as="geometry" /></mxCell><mxCell id="network" parent="1" vertex="1" value="Conectividad regional y cinco sitios&lt;br&gt;VPC Hub: Transit Gateway y Site-to-Site VPN&lt;br&gt;Endpoints privados de servicios AWS&lt;br&gt;ALB web/consolas privados; AS2 de origen restringido&lt;br&gt;Operación local sin WAN; ERP único emisor en Talca" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="0" y="730" width="590" height="150" as="geometry" /></mxCell><mxCell id="ops" parent="1" vertex="1" value="Operación, seguridad y claves&lt;br&gt;CloudWatch · CloudTrail · Config · GuardDuty&lt;br&gt;Security Hub · Inspector · KMS · Secrets Manager&lt;br&gt;Systems Manager · IAM Identity Center&lt;br&gt;Backup y custodia segregada de registros" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="