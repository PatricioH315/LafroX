Color=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=28;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1395" y="620" width="46" height="46" as="geometry" /></mxCell><mxCell id="n34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=28;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;whiteSpace=wrap;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n7" target="n32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365" y="785" /><mxPoint x="365" y="905" /><mxPoint x="1740" y="905" /><mxPoint x="1740" y="635" /></Array></mxGeometry></mxCell><mxCell id="n35" value="&lt;b&gt;Secuencia de despliegue&lt;/b&gt;&lt;table style=&quot;font-size:28px;line-height:1.15;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;GitLab CI orquesta el cambio y ejecuta los controles; bloquea ante hallazgos críticos o altos (&lt;span style=&quot;white-space:nowrap&quot;&gt;RT-04.05&lt;/span&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;2&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;AWS CodeBuild construye la imagen de forma hermética (SLSA nivel 3)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;Amazon ECR guarda la imagen firmada, que se promueve por su digest sin recompilar&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;Migraciones Laravel aditivas y reversibles en Aurora, antes de cambiar el tráfico (&lt;span style=&quot;white-space:nowrap&quot;&gt;RT-04.10&lt;/span&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;Despliegue azul-verde con canario en ECS Fargate y en el sitio emulado: el balanceador de aplicación privado desplaza el tráfico de forma gradual (&lt;span style=&quot;white-space:nowrap&quot;&gt;RT-04.07&lt;/span&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;6&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;El pipeline que orquesta GitLab CI publica los portales Angular en S3 privado, servidos por CloudFront&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4F6F6;strokeColor=#545B64;fontSize=28;fontColor=#232F3E;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="930" width="1760" height="350" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>