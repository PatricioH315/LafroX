Desastres" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=30;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;spacingBottom=6;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="425" y="220" width="870" height="360" as="geometry" /></mxCell><mxCell id="n16" value="&lt;span style=&quot;white-space:nowrap&quot;&gt;us-east-1&lt;/span&gt; · ≈ 7.700 km de la primaria" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=30;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;spacingBottom=6;fontColor=#00A4A6;dashed=1;" vertex="1" parent="1"><mxGeometry x="450" y="285" width="820" height="270" as="geometry" /></mxCell><mxCell id="n17" value="VPC Recuperación · 10.201.0.0/16" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=30;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;spacingBottom=6;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="1"><mxGeometry x="475" y="350" width="770" height="180" as="geometry" /></mxCell><mxCell id="n18" value="ECS Fargate (&lt;span style=&quot;white-space:nowrap&quot;&gt;N-04&lt;/span&gt;)&lt;br&gt;réplica reducida" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=28;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;whiteSpace=wrap;labelPosition=right;verticalAlign=middle;align=left;labelWidth=430;verticalLabelPosition=middle;verticalAlign=middle;align=left;" vertex="1" parent="1"><mxGeometry x="580" y="405" width="90" height="90" as="geometry" /></mxCell><mxCell id="n19" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D6246E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=28;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="385" width="46" height="46" as="geometry" /></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=28;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;whiteSpace=wrap;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n7" target="n18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="375" y="850" /><mxPoint x="375" y="450" /></Array></mxGeometry></mxCell><mxCell id="n21" value="On-premise · CD Talca" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=30;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;spacingBottom=6;fontColor=#7D8998;dashed=0;" vertex="1" parent="1"><mxGeometry x="400" y="650" width="920" height="150" as="geometry" /></mxCell><mxCell id="n22" value="&lt;span style=&quot;white-space:nowrap&quot;&gt;VM-01&lt;/span&gt; wms_only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F6F6;strokeColor=#545B64;fontSize=30;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="710" width="400" height="75" as="geometry" /></mxCell><mxCell id="n23" value="ECS Fargate · wms_only&lt;br&gt;de Talca sobre su copia&lt;br&gt;en Aurora (DMS)" style="rounded=1;arcSize=6;html=1;fillColor=#F4F6F6;strokeColor=#545B64;fontSize=28;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=6;whiteSpace=nowrap;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="900" y="990" width="400" height="125" as="geometry" /></mxCell><mxCell id="n24" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D6246E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=28;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="970" width="46" height="46" as="geometry" /></mxCell><mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=28;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;whiteSpace=wrap;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n22" target="n23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n26" value="&lt;b&gt;Secuencia de despliegue&lt;/b&gt;&lt;table style=&quot;font-size:28px;line-height:1.15;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;GitLab CI orquesta el cambio y ejecuta los controles; bloquea ante hallazgos críticos o altos (&lt;span style=&quot;white-space:nowrap&quot;&gt;RT-04.05&lt;/span&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;2&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;AWS CodeBuild construye la imagen de forma hermética (SLSA nivel 3)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;Amazon ECR guarda la imagen firmada, que se promueve por su digest sin recompilar&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;La réplica reducida de ECS Fargate en &lt;span style=&quot;white-space:nowrap&quot;&gt;us-east-1&lt;/span&gt; recibe cada versión liberada en Producción, desde el ECR de &lt;span style=&quot;white-space:nowrap&quot;&gt;sa-east-1&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:2px 8px 2px 0&quot;&gt;&lt;b style=&quot;color:#D6246E&quot;&gt;5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 0&quot;&gt;Si se pierde la sala de Talca, su perfil wms_only se levanta en ECS Fargate de la región activa sobre su copia en Aurora; los terminales se conectan por la VPN&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4F6F6;strokeColor=#545B64;fontSize=28;fontColor=#232F3E;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="1210" width="1300" height="410" as="geometry" /></mxCell><mxCell id="n27" value="AWS Cloud · región activa (&lt;span style=&quot;white-space:nowrap&quot;&gt;sa-east-1&lt;/span&gt;)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=30;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;spacingBottom=6;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="400" y="835" width="920" height="330" as="geometry" /></mxCell><mxCell id="n29" value="recuperación de la sala" style="rounded=0;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;fontSize=28;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="895" width="390" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>