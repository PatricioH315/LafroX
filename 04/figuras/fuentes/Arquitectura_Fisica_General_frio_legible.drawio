<mxfile host="app.diagrams.net"><diagram id="fisica-frio" name="Física vigente"><mxGraphModel page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="truck" parent="1" vertex="1" value="28 camiones de frío; reserva por familia&lt;br&gt;B-04 Greengrass + B-05/B-06: tres PT100&lt;br&gt;B-03/B-08 y C-02: contraste independiente&lt;br&gt;B-09 Iridium; B-10 a B-15: soporte&lt;br&gt;Alarma local; móvil y SBD en paralelo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FDE8DA;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="0" y="0" width="440" height="150" as="geometry" /></mxCell><mxCell id="users" parent="1" vertex="1" value="Accesos de personas y empresas&lt;br&gt;C-01 Preventa · C-02 Reparto · C-03 Bodega&lt;br&gt;Portales/apps → CloudFront, WAF y Shield&lt;br&gt;Consolas → Verified Access&lt;br&gt;Cadenas → borde AS2 → ALB/OpenAS2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="470" y="0" width="440" height="150" as="geometry" /></mxCell><mxCell id="primary" parent="1" vertex="1" value="AWS sa-east-1 · Producción multi-AZ&lt;br&gt;N-03 API → N-04 ECS Fargate / Keycloak&lt;br&gt;N-05 Aurora; N-07 ElastiCache&lt;br&gt;N-08 IoT Core + CloudConnect/SQS&lt;br&gt;N-06 DynamoDB/S3; N-10 Glue/Redshift&lt;br&gt;N-09 mensajería; N-11 respaldo; N-12/N-13 gestión" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#EDF6FA;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="0" y="190" width="580" height="190" as="geometry" /></mxCell><mxCell id="dr" parent="1" vertex="1" value="AWS us-east-1 · DR&lt;br&gt;Aurora, temperatura y S3&lt;br&gt;Aplicación reducida&lt;br&gt;Copias protegidas&lt;br&gt;RTO ≤4 h; RPO ≤15 min&lt;br&gt;GPS no se replica" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#EDF6FA;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="620" y="190" width="290" height="190" as="geometry" /></mxCell><mxCell id="talca" parent="1" vertex="1" value="CD Talca&lt;br&gt;3 nodos Proxmox/Ceph&lt;br&gt;VM-01 a VM-06; ERP 2017&lt;br&gt;NAS WORM; firewall HA&lt;br&gt;B-01/B-02; UPS y generador&lt;br&gt;Fibra + LTE + Starlink" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="0" y="430" width="285" height="180" as="geometry" /></mxCell><mxCell id="conce" parent="1" vertex="1" value="CD Concepción&lt;br&gt;2 servidores activo/en espera&lt;br&gt;VM-C01 a VM-C04 y copias&lt;br&gt;WMS propio; firewall HA&lt;br&gt;B-01/B-02; UPS&lt;br&gt;Fibra + LTE + Starlink" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="312" y="430" width="285" height="180" as="geometry" /></mxCell><mxCell id="cross" parent="1" vertex="1" value="Cross-docking ×3&lt;br&gt;Curicó, Chillán, Los Ángeles&lt;br&gt;2 mini-PC E-01 por sitio&lt;br&gt;WMS propio; firewall HA; UPS&lt;br&gt;Starlink + LTE Entel/Claro&lt;br&gt;WMS autónomo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="625" y="430" width="285" height="180" as="geometry" /></mxCell><mxCell id="rule" parent="1" vertex="1" value="Cada sitio conserva su autoridad sobre el stock y opera sin WAN.&lt;br&gt;El kit no necesita Internet para proteger el frío. M9 persiste antes de A2 y concilia móvil/SBD." style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Helvetica;fillColor=#F4F4F4;strokeColor=#555555;fontColor=#111111;spacing=6;"><mxGeometry x="0" y="638" width="910" height="64" as="geometry" /></mxCell><mxCell id="truck-primary" parent="1" edge="1" source="truck" target="primary" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#555555;exitX=.5;exitY=1;entryX=.25;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="users-primary" parent="1" edge="1" source="users" target="primary" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#555555;exitX=.5;exitY=1;entryX=.75;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="primary-dr" parent="1" edge="1" source="primary" target="dr" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#555555;exitX=1;exitY=.5;entryX=0;entryY=.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="talca-primary" parent="1" edge="1" source="talca" target="primary" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#555555;exitX=.5;exitY=0;entryX=.15;entryY=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="conce-primary" parent="1" edge="1" source="conce" target="primary" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#555555;exitX=.5;exitY=0;entryX=.5;entryY=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cross-primary" parent="1" edge="1" source="cross" target="primary" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#555555;exitX=.5;exitY=0;entryX=.85;entryY=1;"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>